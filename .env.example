# Server-only Supabase access. Never expose the secret with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Defense in depth in addition to Vercel Authentication. Use long random values.
BASKET_ACCESS_PASSWORD=
BASKET_SESSION_SECRET=

# Enables the local fixture library when Supabase is not configured.
BASKET_DEMO_MODE=true
